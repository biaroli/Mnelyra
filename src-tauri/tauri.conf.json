{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnelyra",
  "version": "0.2.4",
  "identifier": "io.mnelyra.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Mnelyra",
        "width": 1280,
        "height": 800,
        "minWidth": 680,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCRjRFQkRCNTY3OEU0QQpSV1JLam1lMXZVNi9DcHgvTTF1bllNSkNPRmVOUmN3V3F6TFR2UVhlUHVreWFuMDZUVXdXeGFIcAo=",
      "endpoints": [
        "https://github.com/biaroli/Mnelyra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
